<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- 1. 相机预览窗口 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

    <!-- 2. 模式选择栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1AFFFFFF"
        android:padding="15dp"
        android:gravity="center">

        <RadioGroup
            android:id="@+id/rg_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <RadioButton
                android:id="@+id/rb_shoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="射门"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:checked="true"
                android:layout_marginRight="20dp"/>

            <RadioButton
                android:id="@+id/rb_dribble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运球"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginRight="20dp"/>

            <RadioButton
                android:id="@+id/rb_pass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="传球"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
        </RadioGroup>
    </LinearLayout>

    <!-- 3. 开始识别按钮 -->
    <Button
        android:id="@+id/btn_start_recognize"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="开始识别"
        android:textColor="#FFFFFF"
        android:background="#008000"
        android:textSize="18sp"
        android:layout_margin="15dp"/>

    <!-- 4. 识别中结果区 -->
    <LinearLayout
        android:id="@+id/ll_recognizing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#26FFFFFF"
        android:padding="20dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="识别中..."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tv_current_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前动作：射门"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/tv_confidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="置信度：0.87"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="评分：82 分"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_gravity="center"/>

        <Button
            android:id="@+id/btn_stop_recognize"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="结束识别"
            android:textColor="#FFFFFF"
            android:background="#FF4444"
            android:textSize="16sp"
            android:layout_marginTop="15dp"/>
    </LinearLayout>

    <!-- 5. 识别完成结果区 -->
    <LinearLayout
        android:id="@+id/ll_recognized"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#26FFFFFF"
        android:padding="20dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="训练完成"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:layout_gravity="center"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/tv_total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="射门次数：20"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/tv_avg_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="平均评分：78"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tv_suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- 支撑脚不稳\n- 射门角度偏低"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/tv_recording_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="视频状态：未录制"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_save_result"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="保存训练结果"
            android:textColor="#FFFFFF"
            android:background="#008000"
            android:textSize="16sp"
            android:layout_marginTop="15dp"/>
    </LinearLayout>

</LinearLayout>