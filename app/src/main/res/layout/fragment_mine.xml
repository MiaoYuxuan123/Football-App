<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F8FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部信息卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="个人中心"
                android:textColor="#1F2A44"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="管理你的头像与账户信息"
                android:textColor="#8A94A6"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:contentDescription="头像"
                android:scaleType="centerCrop" />

            <Button
                android:id="@+id/btn_upload_avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="上传头像"
                android:textAllCaps="false"
                android:textColor="#4C5BD4"
                android:backgroundTint="#EEF2FF"
                android:paddingLeft="20dp"
                android:paddingRight="20dp" />
        </LinearLayout>

        <!-- 账号信息卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号信息"
                android:textColor="#1F2A44"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="用户名："
                android:textColor="#3D4A63"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- 操作卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btn_help"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="帮助与反馈"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5B8CFF" />

            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="退出登录"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2F3A4F" />
        </LinearLayout>

        <!-- 训练记录区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="训练记录"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/tv_empty_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无训练记录，去训练页完成一次训练后再回来查看。"
                android:textSize="14sp"
                android:visibility="gone"
                android:paddingBottom="8dp" />

            <ListView
                android:id="@+id/lv_train_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:dividerHeight="8dp"
                android:scrollbars="none" />

            <Button
                android:id="@+id/btn_clear_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="清空记录" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
