<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#030507"
                android:startColor="#061018" />
        </shape>
    </item>

    <item android:gravity="top|center_horizontal" android:top="-90dp">
        <shape android:shape="oval">
            <size android:width="420dp" android:height="420dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:centerColor="#1C71E9FF"
                android:endColor="#00000000"
                android:startColor="#3271E9FF" />
        </shape>
    </item>

    <item android:gravity="center_horizontal|bottom" android:bottom="-160dp">
        <shape android:shape="oval">
            <size android:width="520dp" android:height="520dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerColor="#1200C2FF"
                android:endColor="#00000000"
                android:startColor="#2200C2FF" />
        </shape>
    </item>
</layer-list>
