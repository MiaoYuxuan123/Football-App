<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="90"
                android:endColor="#182638"
                android:startColor="#111A28" />
            <stroke
                android:width="1dp"
                android:color="#35577C" />
        </shape>
    </item>

    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape>
            <corners android:radius="22dp" />
            <gradient
                android:angle="90"
                android:endColor="#121A27"
                android:startColor="#0D121C" />
            <stroke
                android:width="1dp"
                android:color="#2A415E" />
        </shape>
    </item>
</layer-list>

